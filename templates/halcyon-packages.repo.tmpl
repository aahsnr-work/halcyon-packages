# The halcyon-packages dnf repository template (GitHub Pages; the live file is
# repo/halcyon-packages.repo). Deployed by ci/publish.sh from the anda-build.yml
# waves; signed with the repo's own GPG key (GPG_PRIVATE_KEY secret).
[halcyon-packages]
name=halcyon-packages for Fedora 44 ($basearch)
baseurl=https://<owner>.github.io/halcyon-packages/repo/f44/x86_64/
type=rpm-md
skip_if_unavailable=True
# prefer this repo over Fedora/Terra whenever the same package name exists in
# both — dnf repo priority wins even if the other repo carries a newer version
priority=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://<owner>.github.io/halcyon-packages/repo/RPM-GPG-KEY-halcyon-packages
enabled=1
enabled_metadata=1
