# halcyon Cloudflare mirror — the same packages as the Copr repo, streamed
# through a free Cloudflare Worker (repo/cloudflare-worker.js is the source;
# deploy it once in the Cloudflare dashboard). The Copr download path
# terminates on S3 in us-east-1, which is single-stream slow from many
# networks; this mirror rides Cloudflare's edge instead and always reflects
# what Copr currently publishes (a live proxy — nothing to sync).
#
# Packages are bit-identical to Copr's and signed with the same project GPG
# key (fetched from Copr below), so the mirror needs no trust of its own —
# gpgcheck verifies every RPM.
#
# Install with:
#   install -Dm644 repo/halcyon-mirror.repo /etc/yum.repos.d/halcyon-mirror.repo
# (use this INSTEAD of halcyon.repo — same priority=1.)

[halcyon-mirror]
name=halcyon (aahsnr-work) — Cloudflare mirror — priority 1
baseurl=https://halcyon-mirror.aahsnr041.workers.dev/fedora-$releasever-x86_64/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/aahsnr-work/halcyon/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
priority=1
