# halcyon Copr repo — highest-priority drop-in for consumers.
#
# Enable with:  install -Dm644 repo/halcyon.repo /etc/yum.repos.d/halcyon.repo
# (or `dnf copr enable aahsnr-work/halcyon fedora-44` and merge the priority=1
# line into the generated file — the copr plugin does not set priorities).
#
# priority=1 (dnf: lower number wins; Fedora/Terra default to 99) makes every
# package this repo builds shadow Fedora, Terra and any unprioritized Copr:
# the hyprwm stack (hyprutils, hyprlang, hyprland, aquamarine, …), glaze,
# hyprwire, hyprtoolkit, chafa, and the CLI tools (zoxide, fd-find, …).
# Packages we do NOT build resolve from Fedora/Terra as usual.

[copr:copr.fedorainfracloud.org:aahsnr-work:halcyon]
name=Copr repo for halcyon (aahsnr-work) — priority 1
baseurl=https://download.copr.fedorainfracloud.org/results/aahsnr-work/halcyon/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/aahsnr-work/halcyon/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
priority=1
